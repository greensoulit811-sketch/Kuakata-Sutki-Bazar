# Supabase Configuration
VITE_SUPABASE_URL=your_supabase_url
VITE_SUPABASE_PUBLISHABLE_KEY=your_supabase_key

# Steadfast Courier Configuration
# Choose ONE method: EDGE_FUNCTION (Supabase) or PROXY (Custom Backend)

# Method 1: Edge Function (default, may fail due to network restrictions)
# Leave these commented if using Method 2

# Method 2: Custom Proxy Backend (RECOMMENDED)
# Set to 'true' to use custom backend proxy instead of Supabase Edge Function
VITE_USE_STEADFAST_PROXY=false

# URL of your custom Steadfast proxy backend
# For development: http://localhost:3001
# For production: https://your-proxy-domain.com
VITE_STEADFAST_PROXY_URL=http://localhost:3001

# API Configuration (used by proxy backend)
STEADFAST_API_BASE=https://portal.steadfast.com.bd/api/v1
STEADFAST_API_KEY=your_steadfast_api_key
STEADFAST_API_SECRET=your_steadfast_api_secret

# Other Configuration
PORT=5173
